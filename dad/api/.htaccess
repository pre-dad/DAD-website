Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Never serve config, notes or data files from this folder
<FilesMatch "^(config|config\.sample)\.php$|^README\.txt$|\.(sqlite|sqlite3|db|log|jsonl|bak|md|txt)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "^(submit|health)\.php$">
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>
