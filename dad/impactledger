/* ============================================================
   COUNTERS
   ============================================================ */
function compact(n){
  if(n>=1e9) return (n/1e9).toFixed(1).replace(/\.0$/,'')+'B';
  if(n>=1e6) return (n/1e6).toFixed(1).replace(/\.0$/,'')+'M';
  if(n>=1e3) return (n/1e3).toFixed(0)+'K';
  return String(Math.round(n));
}
function runCount(el){
  if(el.dataset.done) return;
  el.dataset.done = 1;
  const target = parseFloat(el.dataset.count);
  const pre = el.dataset.prefix || '';
  const suf = el.dataset.suffix || '';
  const dec = parseInt(el.dataset.decimals || 0);
  const isCompact = el.dataset.format === 'compact';
  const dur = 1700, t0 = performance.now();
  function step(t){
    const k = Math.min(1,(t-t0)/dur);
    const e = 1 - Math.pow(1-k, 3);
    const v = target*e;
    el.textContent = pre + (isCompact ? compact(v) : v.toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec})) + suf;
    if(k<1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

/* ---------- sparklines ---------- */
function buildSpark(el){
  if(el.dataset.built) return;
  el.dataset.built = 1;
  const vals = el.dataset.spark.split(',').map(Number);
  const min = Math.min(...vals), max = Math.max(...vals);
  vals.forEach((v,i)=>{
    const b = document.createElement('i');
    b.style.height = '2px';
    el.appendChild(b);
    setTimeout(()=>{
      b.style.height = (8 + ((v-min)/((max-min)||1))*22) + 'px';
    }, i*55);
  });
}
function buildChart(el){
  if(el.dataset.built) return;
  el.dataset.built = 1;
  const vals = el.dataset.chart.split(',').map(Number);
  const min = Math.min(...vals)*0.94, max = Math.max(...vals);
  vals.forEach((v,i)=>{
    const b = document.createElement('div');
    el.appendChild(b);
    setTimeout(()=>{ b.style.height = (14 + ((v-min)/((max-min)||1))*62) + 'px'; }, i*70);
  });
}

/* ============================================================
   REVEAL ON SCROLL
   ============================================================ */
const io = new IntersectionObserver(entries=>{
  entries.forEach(en=>{
    if(!en.isIntersecting) return;
    en.target.classList.add('in');
    en.target.querySelectorAll('[data-count]').forEach(runCount);
    en.target.querySelectorAll('[data-spark]').forEach(buildSpark);
    en.target.querySelectorAll('[data-chart]').forEach(buildChart);
    en.target.querySelectorAll('.bar span').forEach((s,i)=>{
      setTimeout(()=> s.style.width = s.dataset.w + '%', 120 + i*70);
    });
    io.unobserve(en.target);
  });
},{threshold:.14});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

