<script>
/* ============================================================
   US DOT-MATRIX MAP
   ============================================================ */
const NS = 'http://www.w3.org/2000/svg';
const svg = document.getElementById('usmap');

// Stylised continental outline (viewBox 1000 x 540)
const MAINLAND = [
  [60,60],[300,50],[470,44],[506,64],[540,96],[566,114],[600,84],[628,118],
  [652,148],[700,154],[740,140],[780,118],[820,96],[860,72],[898,56],[916,110],
  [892,150],[884,186],[900,204],[898,246],[878,268],[884,300],[890,348],[900,360],
  [930,470],[905,470],[878,382],[840,388],[800,392],[756,402],[706,396],[664,414],
  [622,406],[580,428],[540,452],[518,472],[470,440],[430,412],[392,392],[352,352],
  [264,352],[200,352],[150,376],[120,342],[92,300],[102,268],[62,200],[76,148]
];
const ALASKA = [[52,432],[92,414],[132,424],[152,446],[130,472],[88,480],[58,466]];
const HAWAII = [[186,486],[214,486],[224,502],[196,506]];
const LAKE_MI = [[598,96],[618,98],[620,146],[602,152],[592,124]];
const LAKE_ERIE = [[672,150],[716,146],[718,160],[676,164]];
const SHAPES = [MAINLAND, ALASKA, HAWAII];
const HOLES  = [LAKE_MI, LAKE_ERIE];

function inPoly(x, y, poly){
  let hit = false;
  for(let i=0, j=poly.length-1; i<poly.length; j=i++){
    const xi=poly[i][0], yi=poly[i][1], xj=poly[j][0], yj=poly[j][1];
    if(((yi>y)!==(yj>y)) && (x < (xj-xi)*(y-yi)/(yj-yi)+xi)) hit = !hit;
  }
  return hit;
}
function inUS(x,y){
  return SHAPES.some(p => inPoly(x,y,p)) && !HOLES.some(p => inPoly(x,y,p));
}

// --- dot matrix ---
const dotLayer = document.createElementNS(NS,'g');
const STEP = 11;
let dots = [];
for(let y=40; y<520; y+=STEP){
  for(let x=40; x<965; x+=STEP){
    const ox = (Math.round(y/STEP) % 2) ? STEP/2 : 0;
    const px = x+ox;
    if(!inUS(px,y)) continue;
    const c = document.createElementNS(NS,'circle');
    c.setAttribute('cx',px); c.setAttribute('cy',y); c.setAttribute('r',1.9);
    c.setAttribute('fill','#F8F9FA');
    c.setAttribute('opacity','0');
    dotLayer.appendChild(c);
    dots.push({el:c, x:px, y:y});
  }
}
svg.appendChild(dotLayer);

// stagger the dots in, brighter toward the coasts/centre of activity
dots.forEach(d=>{
  const delay = (d.x/965)*900 + Math.random()*420;
  setTimeout(()=>{
    d.el.style.transition='opacity .7s ease';
    d.el.setAttribute('opacity', (0.10 + Math.random()*0.11).toFixed(3));
  }, delay);
});

/* ---------- delivery sites ---------- */
const CAT = {
  food:   {c:'#FF4A22', label:'Food & nutrition'},
  bills:  {c:'#FFB800', label:'Bills & utilities'},
  house:  {c:'#00D4FF', label:'Housing & shelter'},
  mind:   {c:'#F8F9FA', label:'Mental health'}
};
const SITES = [
  ['Seattle, WA',95,88,'food',18400,'$212K','2m ago'],
  ['Portland, OR',82,132,'house',12100,'$168K','9m ago'],
  ['San Francisco, CA',100,256,'mind',22600,'$304K','just now'],
  ['Los Angeles, CA',128,330,'food',68200,'$742K','1m ago'],
  ['San Diego, CA',146,366,'bills',19800,'$241K','14m ago'],
  ['Phoenix, AZ',216,344,'food',34500,'$389K','6m ago'],
  ['Las Vegas, NV',168,276,'bills',16200,'$198K','21m ago'],
  ['Denver, CO',330,240,'house',24100,'$277K','4m ago'],
  ['Salt Lake City, UT',232,206,'mind',11400,'$142K','33m ago'],
  ['Boise, ID',182,142,'food',8600,'$97K','18m ago'],
  ['Billings, MT',332,112,'bills',5400,'$61K','52m ago'],
  ['Albuquerque, NM',302,300,'house',10900,'$128K','27m ago'],
  ['El Paso, TX',334,348,'food',21700,'$246K','7m ago'],
  ['Minneapolis, MN',520,122,'food',28900,'$318K','3m ago'],
  ['Milwaukee, WI',588,150,'mind',14700,'$171K','11m ago'],
  ['Chicago, IL',592,178,'food',71300,'$806K','just now'],
  ['Detroit, MI',652,166,'bills',44800,'$512K','5m ago'],
  ['Cleveland, OH',700,180,'house',26200,'$291K','16m ago'],
  ['Cincinnati, OH',680,216,'food',19600,'$224K','23m ago'],
  ['Pittsburgh, PA',750,196,'bills',21300,'$248K','12m ago'],
  ['Kansas City, MO',512,216,'food',23400,'$266K','8m ago'],
  ['St. Louis, MO',572,226,'mind',25100,'$284K','19m ago'],
  ['Oklahoma City, OK',482,290,'bills',17800,'$203K','29m ago'],
  ['Little Rock, AR',572,300,'food',13200,'$149K','37m ago'],
  ['Dallas, TX',492,338,'food',48600,'$556K','2m ago'],
  ['Houston, TX',522,386,'house',52300,'$601K','just now'],
  ['New Orleans, LA',612,378,'food',26800,'$302K','15m ago'],
  ['Memphis, TN',602,290,'mind',22400,'$253K','24m ago'],
  ['Nashville, TN',668,272,'mind',20100,'$229K','31m ago'],
  ['Birmingham, AL',664,318,'food',18900,'$214K','13m ago'],
  ['Atlanta, GA',720,308,'food',56400,'$648K','1m ago'],
  ['Charlotte, NC',780,276,'house',24700,'$281K','17m ago'],
  ['Washington, DC',832,214,'bills',33900,'$392K','6m ago'],
  ['Philadelphia, PA',858,182,'food',46200,'$531K','4m ago'],
  ['New York, NY',878,156,'food',94100,'$1.08M','just now'],
  ['Boston, MA',902,126,'house',31600,'$364K','10m ago'],
  ['Orlando, FL',896,406,'food',27300,'$308K','22m ago'],
  ['Miami, FL',906,446,'bills',38200,'$441K','3m ago'],
  ['Anchorage, AK',100,446,'house',4200,'$58K','1h ago'],
  ['Honolulu, HI',203,494,'food',6100,'$74K','44m ago']
];

const pinLayer = document.createElementNS(NS,'g');
svg.appendChild(pinLayer);

const tip = document.getElementById('tip');
const fmt = n => n.toLocaleString('en-US');

SITES.forEach((s,i)=>{
  const [city,x,y,cat,people,amt,time] = s;
  const col = CAT[cat].c;
  const r = 3.2 + Math.min(4.6, Math.sqrt(people)/58);

  const g = document.createElementNS(NS,'g');
  g.setAttribute('class','pin');
  g.setAttribute('opacity','0');

  const halo = document.createElementNS(NS,'circle');
  halo.setAttribute('class','halo');
  halo.setAttribute('cx',x); halo.setAttribute('cy',y);
  halo.setAttribute('r', r*3.4); halo.setAttribute('fill',col);

  const ring = document.createElementNS(NS,'circle');
  ring.setAttribute('cx',x); ring.setAttribute('cy',y);
  ring.setAttribute('r', r*1.9); ring.setAttribute('fill','none');
  ring.setAttribute('stroke',col); ring.setAttribute('stroke-width','.9');
  ring.setAttribute('opacity','.42');

  const core = document.createElementNS(NS,'circle');
  core.setAttribute('class','core');
  core.setAttribute('cx',x); core.setAttribute('cy',y);
  core.setAttribute('r', r); core.setAttribute('fill',col);

  g.append(halo, ring, core);
  pinLayer.appendChild(g);

  setTimeout(()=>{
    g.style.transition='opacity .6s ease';
    g.setAttribute('opacity','1');
  }, 900 + i*38);

  // slow breathing on the biggest sites
  if(people > 40000){
    const an = document.createElementNS(NS,'animate');
    an.setAttribute('attributeName','r');
    an.setAttribute('values', `${r*1.9};${r*3.6};${r*1.9}`);
    an.setAttribute('dur', (2.6 + Math.random()*1.6)+'s');
    an.setAttribute('repeatCount','indefinite');
    const an2 = document.createElementNS(NS,'animate');
    an2.setAttribute('attributeName','opacity');
    an2.setAttribute('values','.55;0;.55');
    an2.setAttribute('dur', (2.6 + Math.random()*1.6)+'s');
    an2.setAttribute('repeatCount','indefinite');
    ring.append(an, an2);
  }

  g.addEventListener('mouseenter', ()=>{
    tip.querySelector('.t-city').textContent = city;
    const p = tip.querySelector('.t-prog');
    p.textContent = CAT[cat].label;
    p.style.color = col;
    tip.querySelector('.t-people').textContent = fmt(people);
    tip.querySelector('.t-amt').textContent = amt;
    tip.querySelector('.t-time').textContent = time;
    const box = svg.getBoundingClientRect();
    tip.style.left = (x/1000*box.width + 10) + 'px';
    tip.style.top  = (y/540*box.height + 8) + 'px';
    tip.style.opacity = 1;
  });
  g.addEventListener('mouseleave', ()=> tip.style.opacity = 0);
});

/* ---------- animated delivery arcs ---------- */
const arcLayer = document.createElementNS(NS,'g');
svg.insertBefore(arcLayer, pinLayer);
function arc(a,b,col,dur,delay){
  const [x1,y1]=a,[x2,y2]=b;
  const mx=(x1+x2)/2, my=(y1+y2)/2 - Math.hypot(x2-x1,y2-y1)*0.28;
  const p = document.createElementNS(NS,'path');
  p.setAttribute('d',`M${x1},${y1} Q${mx},${my} ${x2},${y2}`);
  p.setAttribute('fill','none'); p.setAttribute('stroke',col);
  p.setAttribute('stroke-width','1'); p.setAttribute('opacity','.34');
  p.setAttribute('stroke-dasharray','5 260'); p.setAttribute('stroke-linecap','round');
  const an = document.createElementNS(NS,'animate');
  an.setAttribute('attributeName','stroke-dashoffset');
  an.setAttribute('values','265;0'); an.setAttribute('dur',dur+'s');
  an.setAttribute('begin',delay+'s'); an.setAttribute('repeatCount','indefinite');
  p.appendChild(an);
  arcLayer.appendChild(p);
}
