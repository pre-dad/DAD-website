<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DAD — The Open Ledger</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,"/>
<link rel="apple-touch-icon" href="dad-app-icon.svg"/>
<meta name="theme-color" content="#0E1E1E"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --red:#FF4A22; --gold:#FFB800; --teal:#007A7A; --cyan:#00D4FF;
  --paper:#F8F9FA; --ink:#0E1E1E;
  --surface:#122525; --surface-2:#0B1A1A;
  --line:rgba(248,249,250,0.09);
  --line-2:rgba(0,212,255,0.16);
  --dim:#8FA3A3; --dim-2:#7C9090;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  font-family:'Inter',sans-serif;background:var(--ink);color:var(--paper);
  line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;
}
body::before{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(900px 520px at 12% -8%, rgba(0,122,122,0.34), transparent 62%),
    radial-gradient(760px 460px at 92% 4%, rgba(255,74,34,0.16), transparent 60%),
    radial-gradient(1000px 700px at 50% 108%, rgba(0,212,255,0.07), transparent 62%);
}
body::after{
  content:'';position:fixed;inset:0;pointer-events:none;z-index:1;opacity:.5;
  background-image:linear-gradient(var(--line-2) 1px,transparent 1px),linear-gradient(90deg,var(--line-2) 1px,transparent 1px);
  background-size:64px 64px;
  mask-image:radial-gradient(circle at 50% 30%, #000 0%, transparent 78%);
  -webkit-mask-image:radial-gradient(circle at 50% 30%, #000 0%, transparent 78%);
  opacity:.22;
}
.page{position:relative;z-index:2;}
.wrap{max-width:1320px;margin:0 auto;padding:0 32px;}
h1,h2,h3,.grotesk{font-family:'Space Grotesk',sans-serif;}
.mono{font-family:'IBM Plex Mono',monospace;}
.kicker{
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--red);
}

/* ---------- top bar ---------- */
.topbar{
  position:sticky;top:0;z-index:60;backdrop-filter:blur(16px);
  background:rgba(14,30,30,.82);border-bottom:1px solid var(--line);
}
.topbar .wrap{display:flex;align-items:center;gap:28px;height:68px;}
.brand{display:flex;align-items:center;gap:12px;}
.brand .name{font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:14px;letter-spacing:.16em;text-transform:uppercase;}
.brand .sub{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.14em;color:var(--dim-2);text-transform:uppercase;}
nav{display:flex;gap:26px;margin-left:auto;}
nav a{
  font-size:13px;color:var(--dim);text-decoration:none;padding:6px 0;
  border-bottom:1px solid transparent;transition:.2s;
}
nav a:hover{color:var(--paper);border-bottom-color:var(--red);}
.btn{
  background:#D2360F;color:#fff;border:none;border-radius:999px;
  padding:10px 20px;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;
  cursor:pointer;transition:.2s;white-space:nowrap;
}
.btn:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(255,74,34,.34);}
.btn-ghost{background:transparent;border:1px solid var(--line);color:var(--paper);}
.btn-ghost:hover{border-color:var(--cyan);box-shadow:none;}

/* ---------- live pill ---------- */
.live{
  display:inline-flex;align-items:center;gap:9px;border:1px solid var(--line-2);
  border-radius:999px;padding:6px 14px 6px 11px;
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--cyan);background:rgba(0,212,255,.05);
}
.dot-live{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 0 rgba(0,212,255,.7);animation:pulse 2s infinite;}
@keyframes pulse{
  0%{box-shadow:0 0 0 0 rgba(0,212,255,.55);}
  70%{box-shadow:0 0 0 9px rgba(0,212,255,0);}
  100%{box-shadow:0 0 0 0 rgba(0,212,255,0);}
}

/* ---------- hero ---------- */
.hero{padding:80px 0 44px;}
.hero h1{
  font-size:clamp(38px,5.6vw,74px);font-weight:700;line-height:1.02;
  letter-spacing:-.028em;margin:20px 0 0;max-width:16ch;
}
.hero h1 em{font-style:normal;color:var(--red);}
.hero .lede{
  margin-top:22px;max-width:620px;font-size:17px;color:#C2CFCF;
}
.hero-top{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;flex-wrap:wrap;}
.hero-meta{
  font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--dim-2);
  letter-spacing:.1em;text-transform:uppercase;text-align:right;line-height:2;
}
.hero-meta b{color:var(--paper);font-weight:500;}

/* ---------- hero stat band ---------- */
.band{
  margin-top:56px;display:grid;grid-template-columns:repeat(4,1fr);
  border:1px solid var(--line);border-radius:20px;overflow:hidden;
  background:linear-gradient(180deg,rgba(0,122,122,.20),rgba(11,26,26,.72));
}
.band > div{padding:32px 28px;border-right:1px solid var(--line);position:relative;overflow:hidden;}
.band > div:last-child{border-right:none;}
.band .lbl{
  font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--dim);margin-bottom:14px;
}
.band .num{
  font-family:'Space Grotesk',sans-serif;font-weight:700;letter-spacing:-.03em;
  font-size:clamp(34px,3.9vw,54px);line-height:1;
}
.band .cap{font-size:13px;color:#9FB2B2;margin-top:10px;}
.band .trend{
  display:inline-block;margin-top:12px;font-family:'IBM Plex Mono',monospace;
  font-size:11px;letter-spacing:.06em;padding:3px 9px;border-radius:6px;
  background:rgba(0,212,255,.10);color:var(--cyan);border:1px solid rgba(0,212,255,.2);
}
.band .trend.gold{background:rgba(255,184,0,.10);color:var(--gold);border-color:rgba(255,184,0,.22);}
.band .trend.red{background:rgba(255,74,34,.10);color:#FF7A55;border-color:rgba(255,74,34,.24);}

/* ---------- sections ---------- */
section{padding:78px 0;}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;flex-wrap:wrap;margin-bottom:30px;}
.sec-head h2{font-size:clamp(26px,2.7vw,36px);font-weight:700;letter-spacing:-.02em;margin-top:9px;}
.sec-head p{color:#9FB2B2;font-size:15px;max-width:560px;margin-top:8px;}

/* ---------- map ---------- */
.map-shell{display:grid;grid-template-columns:1fr 336px;gap:22px;align-items:stretch;}
.panel{
  background:linear-gradient(180deg,rgba(18,37,37,.92),rgba(11,26,26,.92));
  border:1px solid var(--line);border-radius:20px;position:relative;overflow:hidden;
}
.panel-pad{padding:24px 26px;}
.panel-head{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:18px 24px;border-bottom:1px solid var(--line);
}
.panel-head h3{font-size:14px;font-weight:500;letter-spacing:.04em;}
.panel-head .sm{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--dim-2);letter-spacing:.12em;text-transform:uppercase;}
#usmap{display:block;width:100%;height:auto;}
.map-wrap{position:relative;padding:8px 10px 4px;}
.legend{
  display:flex;flex-wrap:wrap;gap:8px 20px;padding:14px 26px 20px;border-top:1px solid var(--line);
  font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.07em;color:var(--dim);
}
.legend span{display:inline-flex;align-items:center;gap:8px;}
.legend i{width:8px;height:8px;border-radius:50%;display:inline-block;}
.pin{cursor:pointer;}
.pin .halo{opacity:.16;transition:.25s;}
.pin:hover .halo{opacity:.42;}
.pin .core{transition:.25s;}
.pin:hover .core{r:6.4;}
#tip{
  position:absolute;pointer-events:none;opacity:0;transform:translate(-50%,-118%);
  background:rgba(8,20,20,.97);border:1px solid var(--line-2);border-radius:12px;
  padding:12px 14px;min-width:186px;transition:opacity .16s;z-index:20;
  box-shadow:0 18px 40px rgba(0,0,0,.5);
}
#tip .t-city{font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:14px;}
#tip .t-prog{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;margin-top:5px;}
#tip .t-row{display:flex;justify-content:space-between;gap:14px;font-size:12px;color:#A9BCBC;margin-top:9px;}
#tip .t-row b{color:var(--paper);font-weight:600;font-family:'IBM Plex Mono',monospace;}

/* ---------- feed ---------- */
.feed{height:100%;display:flex;flex-direction:column;}
.feed-body{padding:6px 0 10px;overflow:hidden;position:relative;flex:1;}
.feed-body::after{content:'';position:absolute;left:0;right:0;bottom:0;height:56px;background:linear-gradient(transparent,rgba(11,26,26,.98));pointer-events:none;}
.f-item{
  display:grid;grid-template-columns:8px 1fr;gap:12px;align-items:start;
  padding:13px 22px;border-bottom:1px solid rgba(248,249,250,.05);
  animation:slidein .5s ease both;
}
@keyframes slidein{from{opacity:0;transform:translateY(-10px);}to{opacity:1;transform:none;}}
.f-item .bul{width:8px;height:8px;border-radius:50%;margin-top:6px;}
.f-item .l1{font-size:13px;font-weight:500;}
.f-item .l2{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--dim-2);letter-spacing:.07em;margin-top:3px;text-transform:uppercase;}
.f-item .amt{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--cyan);}

/* ---------- metric grid ---------- */
.mgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px;}
.mcard{
  background:linear-gradient(180deg,rgba(18,37,37,.9),rgba(11,26,26,.9));
  border:1px solid var(--line);border-radius:18px;padding:26px 24px;position:relative;overflow:hidden;
  transition:.25s;
}
.mcard:hover{transform:translateY(-3px);border-color:rgba(0,212,255,.3);}
.mcard::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent,var(--red));}
.mcard .lbl{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);}
.mcard .num{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:42px;letter-spacing:-.03em;line-height:1.05;margin-top:12px;}
.mcard .cap{font-size:12.5px;color:#93A6A6;margin-top:8px;}
.spark{display:flex;align-items:flex-end;gap:3px;height:30px;margin-top:16px;}
.spark i{flex:1;background:var(--accent,var(--red));border-radius:2px 2px 0 0;opacity:.42;transition:.3s;}
.mcard:hover .spark i{opacity:.85;}

/* ---------- programs ledger ---------- */
.ledger{border:1px solid var(--line);border-radius:20px;overflow:hidden;background:rgba(11,26,26,.7);}
.lrow{
  display:grid;grid-template-columns:2.4fr 1fr 1fr 1.5fr 108px;gap:20px;align-items:center;
  padding:18px 26px;border-bottom:1px solid rgba(248,249,250,.06);transition:.2s;
}
.lrow:last-child{border-bottom:none;}
.lrow:hover{background:rgba(0,122,122,.10);}
.lhead{
  font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--dim-2);background:rgba(8,20,20,.7);
}
.lhead:hover{background:rgba(8,20,20,.7);}
.p-name{display:flex;align-items:center;gap:13px;}
.p-name i{width:9px;height:9px;border-radius:2px;flex:none;}
.p-name .n{font-weight:500;font-size:14.5px;}
.p-name .c{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--dim-2);letter-spacing:.1em;text-transform:uppercase;}
.lrow .val{font-family:'IBM Plex Mono',monospace;font-size:14px;}
.bar{height:6px;border-radius:3px;background:rgba(248,249,250,.09);overflow:hidden;}
.bar span{display:block;height:100%;border-radius:3px;width:0;transition:width 1.4s cubic-bezier(.2,.7,.2,1);}
.bar-lbl{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--dim-2);margin-top:6px;letter-spacing:.08em;}
.tag{
  font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  padding:4px 9px;border-radius:6px;text-align:center;white-space:nowrap;
}
.tag.ok{background:rgba(0,212,255,.11);color:var(--cyan);border:1px solid rgba(0,212,255,.22);}
.tag.run{background:rgba(255,184,0,.11);color:var(--gold);border:1px solid rgba(255,184,0,.24);}
.tag.new{background:rgba(255,74,34,.11);color:#FF8462;border:1px solid rgba(255,74,34,.26);}

/* ---------- outcomes ---------- */
.ogrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;}
.ocard{
  border:1px solid var(--line);border-radius:18px;padding:26px;
  background:linear-gradient(180deg,rgba(18,37,37,.9),rgba(11,26,26,.9));
}
.ocard h3{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:500;}
.ocard .big{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:52px;letter-spacing:-.035em;line-height:1;margin:14px 0 6px;}
.ocard .note{font-size:12.5px;color:#8FA3A3;}
.ocard .src{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--dim-2);letter-spacing:.1em;text-transform:uppercase;margin-top:16px;padding-top:14px;border-top:1px solid var(--line);}
.chart{display:flex;align-items:flex-end;gap:7px;height:76px;margin:18px 0 4px;}
.chart div{flex:1;border-radius:3px 3px 0 0;background:linear-gradient(180deg,var(--cyan),rgba(0,212,255,.15));height:0;transition:height 1.2s cubic-bezier(.2,.7,.2,1);}

/* ---------- initiatives ---------- */
.init{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;}
.icard{border:1px solid var(--line);border-radius:18px;padding:24px;background:rgba(11,26,26,.66);transition:.25s;}
.icard:hover{border-color:rgba(255,74,34,.34);transform:translateY(-3px);}
.icard .co{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);}
.icard h3{font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:500;margin:10px 0 8px;}
.icard p{font-size:13.5px;color:#93A6A6;min-height:42px;}
.imeta{display:flex;justify-content:space-between;font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--dim-2);letter-spacing:.08em;margin:16px 0 7px;text-transform:uppercase;}

/* ---------- partners ---------- */
.pstrip{
  display:flex;gap:14px;flex-wrap:wrap;justify-content:center;
  border:1px solid var(--line);border-radius:20px;padding:30px 26px;background:rgba(11,26,26,.6);
}
.pchip{
  font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.1em;
  border:1px solid var(--line);border-radius:999px;padding:9px 17px;color:#A9BCBC;transition:.2s;
}
.pchip:hover{border-color:var(--gold);color:var(--gold);}

/* ---------- cta ---------- */
.cta{
  border:1px solid rgba(255,74,34,.3);border-radius:24px;padding:56px 48px;text-align:center;
  background:radial-gradient(700px 320px at 50% 0%, rgba(255,74,34,.16), rgba(11,26,26,.9));
}
.cta h2{font-size:clamp(28px,3.4vw,44px);font-weight:700;letter-spacing:-.025em;}
.cta p{color:#A9BCBC;max-width:520px;margin:14px auto 26px;font-size:15.5px;}

footer{border-top:1px solid var(--line);padding:34px 0 60px;}
.fbot{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--dim-2);letter-spacing:.1em;text-transform:uppercase;}

.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease;}
.reveal.in{opacity:1;transform:none;}

@media(max-width:1080px){
  .map-shell{grid-template-columns:1fr;}
  .band{grid-template-columns:repeat(2,1fr);}
  .band > div:nth-child(2){border-right:none;}
  .band > div:nth-child(-n+2){border-bottom:1px solid var(--line);}
  .lrow{grid-template-columns:2fr 1fr 1.4fr;}
  .lrow > *:nth-child(3){display:none;}
  nav{display:none;}
}
@media(max-width:640px){
  .wrap{padding:0 20px;}
  .topbar{position:static;}
  .topbar .wrap{flex-wrap:wrap;height:auto;gap:10px 12px;padding-top:12px;padding-bottom:12px;}
  .topbar .btn{padding:10px 14px;}
  .band{grid-template-columns:1fr;}
  .band > div{border-right:none;border-bottom:1px solid var(--line);}
  .lrow{grid-template-columns:1.6fr 1fr;}
  .lrow > *:nth-child(2),.lrow > *:nth-child(4){display:none;}
  .hero-meta{text-align:left;}
}
.panel-head .btn{padding:6px 14px;font-size:12px;}
.skip{position:absolute;left:12px;top:-60px;z-index:100;background:var(--paper);color:var(--ink);padding:10px 16px;border-radius:999px;font-weight:600;font-size:14px;text-decoration:none;}
.skip:focus{top:12px;}
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto;}
  *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;}
  .reveal{opacity:1;transform:none;}
}
</style>
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<div class="page">

<!-- ============ TOP BAR ============ -->
<header class="topbar">
  <div class="wrap">
    <div class="brand">
      <svg viewBox="-6 -6 142 112" width="34" role="img" aria-label="DAD logomark">
        <g transform="translate(88,0) scale(-1,1)"><path fill="#FF4A22" fill-rule="evenodd" d="M0,0 H38 A50,50 0 0 1 38,100 H0 Z M24,24 H36 A26,26 0 0 1 36,76 H24 Z"/></g>
        <rect x="100" y="16" width="9" height="68" rx="4.5" fill="#FF4A22"/>
        <rect x="117" y="32" width="6" height="36" rx="3" fill="#FF4A22"/>
      </svg>
      <div>
        <div class="name">Dynamic Aid Delivery</div>
        <div class="sub">The Open Ledger</div>
      </div>
    </div>
    <nav>
      <a href="#map">Map</a>
      <a href="#programs">Programs</a>
      <a href="#outcomes">Outcomes</a>
      <a href="#initiatives">Initiatives</a>
      <a href="#partners">Partners</a>
    </nav>
    <button class="btn btn-ghost">Download data</button>
    <button class="btn">Give $1 a day</button>
  </div>
</header>

<main id="content" tabindex="-1">
<!-- ============ HERO ============ -->
<div class="hero">
  <div class="wrap">
    <div class="hero-top">
      <div>
        <div class="live"><span class="dot-live"></span> Ledger live · syncing every 11 seconds</div>
        <h1>Aid, delivered.<br><em>Verified on arrival.</em></h1>
        <p class="lede">Every dollar is traced from donation to program to verified outcome, then published continuously — not summarised once a year. This is the whole ledger. Nothing is held back.</p>
      </div>
      <div class="hero-meta">
        Ledger opened <b>04 Jan 2027</b><br>
        Last write <b id="lastwrite">just now</b><br>
        Independent audits <b>7 of 7 passed</b><br>
        Records published <b>1,284,006</b>
      </div>
    </div>

    <div class="band reveal">
      <div>
        <div class="lbl">People helped</div>
        <div class="num" data-count="2417880" data-suffix="">0</div>
        <div class="cap">Unique individuals reached across 120 active programs.</div>
        <div class="trend">▲ 84,110 this quarter</div>
      </div>
      <div>
        <div class="lbl">Meals funded</div>
        <div class="num" data-count="41200000" data-format="compact">0</div>
        <div class="cap">Delivered through 214 food partners and 38 mobile pantries.</div>
        <div class="trend gold">▲ 12.4% vs. last quarter</div>
      </div>
      <div>
        <div class="lbl">Bills paid</div>
        <div class="num" data-count="18740000" data-prefix="$" data-format="compact">0</div>
        <div class="cap">Rent, utilities and medical arrears cleared at the source.</div>
        <div class="trend">▲ $1.9M this quarter</div>
      </div>
      <div>
        <div class="lbl">Traceable to outcome</div>
        <div class="num" data-count="100" data-suffix="%">0</div>
        <div class="cap">Every dollar carries a receipt. Unverified spend is published as unverified.</div>
        <div class="trend red">0 unreconciled records</div>
      </div>
    </div>
  </div>
</div>

<!-- ============ MAP ============ -->
<section id="map">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <div class="kicker">01 — Where the work is</div>
        <h2>1,942 delivery sites. One map.</h2>
        <p>Each point is a funded program site with a published outcome record. Hover any point to see what it runs, who it reaches, and when it last reported.</p>
      </div>
      <div class="live"><span class="dot-live"></span> 62 sites reporting now</div>
    </div>

    <div class="map-shell">
      <div class="panel reveal">
        <div class="panel-head">
