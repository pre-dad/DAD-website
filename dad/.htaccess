Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Get Involved was renamed The Movement (2026-10-17)
RedirectMatch 301 ^/get-involved/?$ /movement/

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/javascript .js .mjs
</IfModule>

# Extension-less page: without this Apache may send it as a download.
<Files "impactledger">
  ForceType text/html
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  # map/ loads third-party scripts, styles and fonts, so it keeps its own markup and no CSP.
  <If "%{REQUEST_URI} !~ m#^/(on-prem-infra/|map/)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-HJ2fANSo4M+Cgo/Xcyt9Y7exhcdEaWVDnwQE1HcuxF0=' 'sha256-XbJJnf+2ptApBo2vIPlNH/+SacoYH6cVPzGXajNY21g='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  </If>
  # Internal budget viewer: self-hosted three.js, inline script and fonts, kept out of search indexes.
  <If "%{REQUEST_URI} =~ m#^/on-prem-infra/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Every reference to these carries ?v=<hash> (tools/build.mjs), so a changed file gets a new URL.
  <If "%{REQUEST_URI} =~ m#^/(css|js|vendor)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
