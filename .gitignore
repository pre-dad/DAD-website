# ==========================================================================
# DAD website (dynamicaid.org) — private repo: CoachCoe/dad-main-website
# The repo root is this `website/` folder; the site lives under `dad/`.
# This file keeps ALL secrets and live data out of git, and limits the repo
# to the marketing site + its /api (the non-site PHP apps are excluded).
# ==========================================================================

# --- OS cruft ---
.DS_Store
**/.DS_Store

# --------------------------------------------------------------------------
# SECRETS — never commit (defense in depth: catch-all + explicit)
# --------------------------------------------------------------------------
**/config.php
!**/config.sample.php
**/stripe.key
.env
.env.*
**/.env
**/.env.*

# --------------------------------------------------------------------------
# LIVE DATA — sign-ups, IP salt, DeckSend data (the ONLY copy; back up via SFTP)
# --------------------------------------------------------------------------
dad/dad-site-data-*/
dad/ds-data-*/
dad/ds-stage-*/
**/*.sqlite
**/*.sqlite3
**/*.db

# --- local dev mock output (if serve.py is added later) ---
_local-data/
**/*.jsonl

# --------------------------------------------------------------------------
# NON-SITE APPS — migrated/retired separately, out of this repo (per decision)
# --------------------------------------------------------------------------
dad/decksend/
dad/view/
dad/r1-prd/
dad/living-org-chart/
dad/convodeckv2/

# --------------------------------------------------------------------------
# STAGING / DETRITUS — not part of the deployable site
# --------------------------------------------------------------------------
dad/preview-*/
dad/probe-*/
dad/deck-1-*/
dad/DAD-Convo Deck.html
