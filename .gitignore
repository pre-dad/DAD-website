# OS cruft
.DS_Store

# Secrets: never commit (config.sample.php is the tracked template)
**/config.php
!**/config.sample.php
**/stripe.key
.env
.env.*

# Live data: the sign-ups database is the only copy; back it up from the server
dad/dad-site-data-*/
dad/ds-data-*/
dad/ds-stage-*/
**/*.sqlite
**/*.sqlite3
**/*.db

# Installed tooling and test output. Do not ignore dad/vendor/: it is the site's shipped JS.
node_modules/
dad/.phpunit-vendor/
dad/.phpunit.cache/
dad/tests-e2e/playwright-report/
dad/tests-e2e/test-results/
dad/tests-e2e/.cache/
dad/dad-ci-data-*/
dad/api/config.php.ci-backup

# Other apps that share the old webroot locally but live outside this repo
dad/decksend/
dad/view/
dad/r1-prd/
dad/living-org-chart/
dad/convodeckv2/
dad/preview-*/
dad/probe-*/
dad/deck-1-*/
dad/DAD-Convo Deck.html

# Working notes and agent files: never commit
*.local.md
.agents/
**/*-plan.md
**/*-review.md
**/*-review.json
